[Unit]
Description=AutoAce AI dashboard (Next.js)
After=network.target

[Service]
Type=simple
User=autoace
Group=autoace
WorkingDirectory=/var/www/autoace.tdlv.dev/web
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm run start -- -p 3000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
