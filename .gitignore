# Confidential audio / labels — never committed
data/labeled_samples/*
!data/labeled_samples/.gitkeep
*.wav
*.mp3
*.m4a
*.flac
# Anchored to repo root: an unanchored `batches/` here would also match
# web/src/app/batches/ (the dashboard's real batch-detail route) and
# silently drop it from git — learned the hard way.
/uploads/
/batches/
inference/data/

# Python
inference/.venv/
__pycache__/
*.pyc
.pytest_cache/
inference/models/*
!inference/models/.gitkeep

# Node / Next.js
web/node_modules/
web/.next/
web/out/

# Env / secrets
.env
.env.*
!.env.example

# OS
.DS_Store

# autoace's $HOME is this repo root, so tool caches land here too
/.cache/
/.npm/
