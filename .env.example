# Copy to .env and source it (or export these directly) before running
# uvicorn / next dev. Never commit the real .env — it's gitignored.

# Single admin credential for the dashboard (Milestone 6) — see
# inference/api/auth.py. No multi-user accounts exist.
AUTOACE_ADMIN_USERNAME=admin
# Preferred for production: a pre-generated bcrypt hash (see
# inference/api/auth.py's CryptContext) instead of a plaintext password.
AUTOACE_ADMIN_PASSWORD_HASH=
# Dev-only fallback if AUTOACE_ADMIN_PASSWORD_HASH is unset — hashed at
# process start, never stored. Don't rely on this in production.
AUTOACE_ADMIN_PASSWORD=change-me

# Signs session cookies. If unset, a random key is generated per process
# start (sessions won't survive a restart) — set this in production.
AUTOACE_SECRET_KEY=

# Set to "true" once served over HTTPS (production, behind the nginx TLS
# config in deploy/nginx.conf) so the session cookie gets the Secure flag.
AUTOACE_COOKIE_SECURE=false

# Dev only: origins allowed to call the API cross-origin. Not used in
# production — nginx serves the dashboard and API from the same origin.
AUTOACE_DEV_CORS_ORIGINS=http://localhost:3001

# Dev only: where web/next.config.ts's rewrite proxies /api/* to.
AUTOACE_API_ORIGIN=http://127.0.0.1:8001
